{
  "tagname-lowercase": true,
  "attr-lowercase": true,
  "attr-value-double-quotes": true,
  "doctype-first": true,
  "id-unique": true,
  "src-not-empty": true,
  "attr-no-duplication": true,
  "title-require": true,
  "tag-pair": true,
  "spec-char-escape": true,
  "space-tab-mixed-disabled": "space",
  "attr-unsafe-chars": true,
  "href-abs-or-rel": "rel",
  "custom-tags": ["th:block","th:each","th:if","th:unless","th:replace","th:include"],
  "custom-attrs": ["th:text","th:utext","th:value","th:href","th:src","th:action","th:each","th:if","th:unless","th:replace","th:include"]
}